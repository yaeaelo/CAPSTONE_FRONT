VITE_APP_TITLE=BeatsCloud

# 'mock' (default): datos en localStorage, sin backend.  'rest': usa la API de Django (app/api_shim.py).
VITE_API_MODE=mock

# Vacío = mismo origen (Vite hace proxy a Django, ver vite.config.ts). Solo definir para apuntar
# directo a otro host; en ese caso Django necesita CORS + DJANGO_CSRF_TRUSTED_ORIGINS.
VITE_DJANGO_URL=

# Las credenciales de Transbank NO van aquí: cualquier variable VITE_* queda visible en el navegador.
# Viven únicamente en el .env del backend (TRANSBANK_COMMERCE_CODE / TRANSBANK_API_KEY).
